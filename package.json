{
  "name": "proyectosueldos",
  "version": "1.0.0",
  "description": "API SaaS multi-tenant para liquidación de haberes",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate:master": "prisma generate --schema=prisma/schema.prisma",
    "prisma:generate:tenant": "prisma generate --schema=prisma/schema.tenant.prisma",
    "prisma:generate": "npm run prisma:generate:master && npm run prisma:generate:tenant",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma",
    "seed:clae": "node src/scripts/seedClae.js",
    "test": "node test-e2e.js",
    "notebook:status": "node src/scripts/notebooklm/status.js",
    "notebook:auth": "node src/scripts/notebooklm/auth.js",
    "notebook:add": "node src/scripts/notebooklm/add.js",
    "notebook:query": "node src/scripts/notebooklm/query.js"
  },
  "keywords": [
    "saas",
    "payroll",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tabler/core": "^1.4.0",
    "@tabler/icons-webfont": "^3.46.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3"
  }
}
