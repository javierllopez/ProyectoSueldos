# Entorno
NODE_ENV=development
PORT=3000

# Base de datos MASTER (cuentas, usuarios, permisos y registro de empresas)
DATABASE_URL="mysql://USUARIO:CONTRASEÑA@localhost:3306/sueldos_master"

# Credenciales para conectarse a las bases de datos de cada empresa (tenants).
# La URL se arma en runtime con el dbName/dbHost/dbPort que figura en CompanyRegistry.
TENANT_DB_USER=""
TENANT_DB_PASSWORD=""

# Autenticación
JWT_SECRET="GENERAR_UNO_LARGO_Y_ALEATORIO"
JWT_EXPIRES_IN="8h"
